@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var canDrive = User.IsInRole("Driver") || User.IsInRole("Both");
    var canRide = User.IsInRole("Passenger") || User.IsInRole("Both");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolRide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark sr-nav">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">SchoolRide</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (isAuth && canRide)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Rides" asp-action="Index">Find a ride</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="Mine">My bookings</a></li>
                }
                @if (isAuth && canDrive)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Rides" asp-action="Create">Post a ride</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Rides" asp-action="Mine">My rides</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="Requests">Requests</a></li>
                }
                @if (isAuth && !isAdmin)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Verification" asp-action="Index">Verification</a></li>
                }
                @if (isAdmin)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Verification" asp-action="Review">Review verifications</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                @if (isAuth)
                {
                    <li class="nav-item"><span class="navbar-text me-3">@User.Identity!.Name</span></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button class="btn btn-outline-light btn-sm">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="btn btn-warning btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Sign up</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    @foreach (var (key, css) in new[] { ("Success", "success"), ("Warning", "warning"), ("Error", "danger") })
    {
        if (TempData[key] is string msg)
        {
            <div class="alert alert-@css alert-dismissible fade show" role="alert">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    }
    @RenderBody()
</main>

<footer class="text-center text-muted small py-4">
    SchoolRide prototype. Student-only ride sharing for Gaborone's tertiary institutions.
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
