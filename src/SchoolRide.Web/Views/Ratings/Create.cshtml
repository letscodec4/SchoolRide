@model RatingViewModel
@{ ViewData["Title"] = "Rate trip"; }
<div class="row justify-content-center"><div class="col-md-6">
<div class="card"><div class="card-body p-4">
    <h2 class="h4">Rate @Model.OtherName</h2>
    <p class="text-muted">@Model.RouteText</p>
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="BookingId" />
        <input type="hidden" asp-for="OtherName" />
        <input type="hidden" asp-for="RouteText" />
        <div class="mb-3">
            <label asp-for="Score" class="form-label">Score</label>
            <select asp-for="Score" class="form-select">
                <option value="5">5 - Excellent</option><option value="4">4 - Good</option><option value="3">3 - Okay</option>
                <option value="2">2 - Poor</option><option value="1">1 - Bad</option>
            </select>
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>
        <div class="mb-3"><label asp-for="Comment" class="form-label">Comment (optional)</label><textarea asp-for="Comment" class="form-control" rows="3"></textarea><span asp-validation-for="Comment" class="text-danger"></span></div>
        <button class="btn btn-primary w-100">Submit rating</button>
    </form>
</div></div></div></div>
