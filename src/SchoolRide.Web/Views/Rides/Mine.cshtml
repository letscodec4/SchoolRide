@model List<Ride>
@{ ViewData["Title"] = "My rides"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">My rides</h2>
    <a class="btn btn-primary" asp-action="Create">Post a ride</a>
</div>
@if (!Model.Any()) { <div class="alert alert-light border">You have not posted any rides yet.</div> }
@foreach (var r in Model)
{
    var pending = r.Bookings.Count(b => b.Status == BookingStatus.Pending);
    var accepted = r.Bookings.Where(b => b.Status == BookingStatus.Accepted).ToList();
    <div class="card mb-2"><div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-2">
            <div>
                <div class="fw-semibold">@r.Origin.DisplayName() &rarr; @r.Destination.DisplayName() <span class="badge text-bg-secondary">@r.Status</span></div>
                <div class="text-muted small">@r.DepartureTime.ToString("ddd dd MMM, HH:mm") &middot; @r.SeatsAvailable/@r.SeatsTotal seat(s) free &middot; P@(r.PricePerSeat.ToString("0.00")) per seat</div>
                @if (pending > 0) { <div class="small mt-1"><a asp-controller="Bookings" asp-action="Requests">@pending request(s) waiting for your answer</a></div> }
                @if (accepted.Any()) { <div class="small mt-1">Passengers: @string.Join(", ", accepted.Select(b => $"{b.Passenger.FullName} ({b.SeatsRequested})"))</div> }
            </div>
            @if (r.Status == RideStatus.Open)
            {
                <div class="d-flex gap-2 align-items-start">
                    <form asp-action="Complete" asp-route-id="@r.Id" method="post"><button class="btn btn-success btn-sm">Mark trip complete</button></form>
                    <form asp-action="Cancel" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Cancel this ride and its bookings?');"><button class="btn btn-outline-danger btn-sm">Cancel</button></form>
                </div>
            }
        </div>
    </div></div>
}
